query IIIIIIII
SELECT count(*) FILTER (WHERE tcp_fin), count(*) FILTER (WHERE tcp_syn),
       count(*) FILTER (WHERE tcp_rst), count(*) FILTER (WHERE tcp_psh),
       count(*) FILTER (WHERE tcp_ack_flag), count(*) FILTER (WHERE tcp_urg),
       count(*) FILTER (WHERE tcp_ece), count(*) FILTER (WHERE tcp_cwr)
FROM read_packets('test/data/flags/all_flags.pcap');
----
128	128	128	128	128	128	128	128

query I
SELECT count(*) FROM read_packets('test/data/flags/all_flags.pcap')
WHERE tcp_fin IS DISTINCT FROM ((tcp_flags & 1) != 0)
   OR tcp_syn IS DISTINCT FROM ((tcp_flags & 2) != 0)
   OR tcp_rst IS DISTINCT FROM ((tcp_flags & 4) != 0)
   OR tcp_psh IS DISTINCT FROM ((tcp_flags & 8) != 0)
   OR tcp_ack_flag IS DISTINCT FROM ((tcp_flags & 16) != 0)
   OR tcp_urg IS DISTINCT FROM ((tcp_flags & 32) != 0)
   OR tcp_ece IS DISTINCT FROM ((tcp_flags & 64) != 0)
   OR tcp_cwr IS DISTINCT FROM ((tcp_flags & 128) != 0);
----
0

statement ok
PREPARE filtered_packets AS SELECT count(*) FROM read_packets('test/data/protocols/chunks.pcap') WHERE dst_port = $1;

query I
EXECUTE filtered_packets(443);
----
1500

query I
EXECUTE filtered_packets(53);
----
1500

query I
SELECT count(*) FROM read_packets('test/data/protocols/chunks.pcap') p
JOIN (VALUES (443), (53)) ports(port) ON p.dst_port = ports.port;
----
3000

statement ok
DROP TABLE packet_baseline;

statement ok
DROP TABLE dns_baseline;

# Rejected packets still validate their capture framing.

