# name: test/sql/pushdown.test
# description: pushed filters agree with materialized SQL and preserve flag/null semantics
# group: [sql]

require packetquapture

statement ok
CREATE TEMP TABLE packet_baseline AS SELECT * FROM read_packets('test/data/protocols/*');

query I
SELECT count(*) FROM (
  (SELECT * FROM read_packets('test/data/protocols/*') WHERE dst_port = 443
   EXCEPT ALL SELECT * FROM packet_baseline WHERE dst_port = 443)
  UNION ALL
  (SELECT * FROM packet_baseline WHERE dst_port = 443
   EXCEPT ALL SELECT * FROM read_packets('test/data/protocols/*') WHERE dst_port = 443)
);
----
0

