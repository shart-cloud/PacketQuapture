# name: test/sql/parallel_scans.test
# description: whole-file workers preserve row multiplicity, projections, and staged filters
# group: [sql]

require packetquapture

statement ok
SET threads=1;

statement ok
CREATE TEMP TABLE baseline_read_pcap AS SELECT * FROM read_pcap(['test/data/parallel/*.pcap*', 'test/data/sample.pcapng', 'test/data/protocols/*', 'test/data/dns/*.pcap*', 'test/data/protocols/ethernet.pcap', 'test/data/dns/messages.pcap']);

statement ok
CREATE TEMP TABLE baseline_read_packets AS SELECT * FROM read_packets(['test/data/parallel/*.pcap*', 'test/data/sample.pcapng', 'test/data/protocols/*', 'test/data/dns/*.pcap*', 'test/data/protocols/ethernet.pcap', 'test/data/dns/messages.pcap']);

statement ok
CREATE TEMP TABLE baseline_read_dns AS SELECT * FROM read_dns(['test/data/parallel/*.pcap*', 'test/data/sample.pcapng', 'test/data/protocols/*', 'test/data/dns/*.pcap*', 'test/data/protocols/ethernet.pcap', 'test/data/dns/messages.pcap']);

foreach workers 1 2 4 8

statement ok
SET threads=${workers};

query I
SELECT count(*) FROM ((SELECT * FROM read_pcap(['test/data/parallel/*.pcap*', 'test/data/sample.pcapng', 'test/data/protocols/*', 'test/data/dns/*.pcap*', 'test/data/protocols/ethernet.pcap', 'test/data/dns/messages.pcap']) WHERE true EXCEPT ALL SELECT * FROM baseline_read_pcap WHERE true) UNION ALL (SELECT * FROM baseline_read_pcap WHERE true EXCEPT ALL SELECT * FROM read_pcap(['test/data/parallel/*.pcap*', 'test/data/sample.pcapng', 'test/data/protocols/*', 'test/data/dns/*.pcap*', 'test/data/protocols/ethernet.pcap', 'test/data/dns/messages.pcap']) WHERE true));
