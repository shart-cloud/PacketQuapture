# name: test/sql/catalog_pruning.test
# description: Runtime timestamp catalog selection preserves complete packet rows
# group: [sql]

require packetquapture

statement ok
CREATE TABLE time_catalog AS SELECT * FROM capture_inventory(['test/data/flows/tcp.pcap','test/data/flows/udp.pcap','test/data/inventory/all-null.pcapng','test/data/inventory/empty.pcap']);

statement ok
SET threads=1;

query I
SELECT count(*) FROM ((SELECT * FROM read_pcap(['test/data/flows/tcp.pcap','test/data/flows/udp.pcap','test/data/inventory/all-null.pcapng','test/data/inventory/empty.pcap','test/data/flows/udp.pcap']) WHERE timestamp < TIMESTAMP '1970-01-01' EXCEPT ALL SELECT * FROM read_pcap(['test/data/flows/tcp.pcap','test/data/flows/udp.pcap','test/data/inventory/all-null.pcapng','test/data/inventory/empty.pcap','test/data/flows/udp.pcap'],catalog='time_catalog',catalog_validation='immutable') WHERE timestamp < TIMESTAMP '1970-01-01') UNION ALL (SELECT * FROM read_pcap(['test/data/flows/tcp.pcap','test/data/flows/udp.pcap','test/data/inventory/all-null.pcapng','test/data/inventory/empty.pcap','test/data/flows/udp.pcap'],catalog='time_catalog',catalog_validation='immutable') WHERE timestamp < TIMESTAMP '1970-01-01' EXCEPT ALL SELECT * FROM read_pcap(['test/data/flows/tcp.pcap','test/data/flows/udp.pcap','test/data/inventory/all-null.pcapng','test/data/inventory/empty.pcap','test/data/flows/udp.pcap']) WHERE timestamp < TIMESTAMP '1970-01-01'));
----
0

