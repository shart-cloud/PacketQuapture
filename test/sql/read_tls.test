# ALPN edge cases, as JA4.md and tshark 4.2.2 render them: a GREASE first
# value as sent, in hex; a single character twice; a non-alphanumeric value
# as the first and last digit of its hex. The FoxIO implementations differ
# from JA4.md here; see TLS_HANDSHAKES.md.
query II
SELECT client_port, ja4 FROM read_tls('test/data/tls/alpn_edges.pcap') ORDER BY client_port;
----
51001	t12i01010a_0f2cb44170f4_000000000000
51002	t12i0101xx_0f2cb44170f4_000000000000
51003	t12i0101a1_0f2cb44170f4_000000000000

# JA4 does not use supported_groups, so a malformed one leaves it defined.
query III
SELECT ja3, ja4, ja4_r FROM read_tls('test/data/tls/malformed_groups.pcap');
----
NULL	t12d010200_0f2cb44170f4_a8f3e973773c	t12d010200_1301_000a

query IIII
SELECT ja4, ja4_r, ja4s, ja4s_r FROM read_tls('test/data/tls/list_limit.pcap');
----
NULL	NULL	NULL	NULL

query IIII
SELECT ja4, ja4s, ja4_r, ja4s_r FROM read_tls('test/data/tls/client_only.pcap');
----
t12d010100_0f2cb44170f4_000000000000	NULL	t12d010100_1301_	NULL

query IIII
SELECT ja4, ja4s, ja4_r, ja4s_r FROM read_tls('test/data/tls/server_only.pcap');
----
NULL	t120000_1301_000000000000	NULL	t120000_1301_

query III
SELECT handshake_number, ja4, ja4s FROM read_tls('test/data/tls/renegotiated.pcap') ORDER BY handshake_number;
----
1	t12d010100_0f2cb44170f4_000000000000	t120000_1301_000000000000
2	t12d010100_0f2cb44170f4_000000000000	t120000_1301_000000000000

# Each hash is the first 12 hex digits of SHA-256 over the matching raw part,
# or zeros for an empty part.
query I
WITH parts AS (
    SELECT ja4, string_split(ja4_r, '_') AS r, ja4s, string_split(ja4s_r, '_') AS s
    FROM read_tls('test/data/tls/*.pcap') WHERE ja4 IS NOT NULL OR ja4s IS NOT NULL),
hashed AS (
    SELECT *, list_transform([r[2], array_to_string(r[3:], '_'), s[3]],
                             lambda p: CASE WHEN p = '' THEN '000000000000' ELSE left(sha256(p), 12) END) AS h
    FROM parts)
SELECT count(*) FROM hashed
WHERE ja4 IS DISTINCT FROM CASE WHEN r IS NULL THEN NULL ELSE r[1] || '_' || h[1] || '_' || h[2] END
   OR ja4s IS DISTINCT FROM CASE WHEN s IS NULL THEN NULL ELSE s[1] || '_' || s[2] || '_' || h[3] END;
----
0

# 1,024 quiet connections fill every tracked TCP direction. They are evicted after
# the 300 s idle timeout, so a later handshake is still reported rather than lost
# to the direction limit.
query TTT
SELECT tls_sni, reassembly_status, warnings FROM read_tls('test/data/tls/idle_eviction.pcap');
----
after-idle.example	complete	[]

# The server's certificate chain, leaf first. Names are the RFC 4514 strings
# OpenSSL 3.0.13 prints with -nameopt RFC2253,-esc_msb. Serials, times and SANs
# are tshark 4.2.2's x509af.serialNumber, x509af.utcTime/generalizedTime,
# x509ce.dNSName and x509ce.iPAddress. The fixture's Teletex locality is read
# as Latin-1, as OpenSSL does; tshark decodes it as T.61.
query IT
SELECT i, s.subject FROM (SELECT unnest(server_certificates) AS s, generate_subscripts(server_certificates, 1) AS i
FROM read_tls('test/data/tls/certificates.pcap')) ORDER BY i;
----
1	CN=\ #www.example.test\ ,1.3.6.1.4.1.55555.1=#0C0770726976617465,emailAddress=ops@example.test,O=été,O=Beispiel\, \"Grün\" \+ Co \<AG\>\;,L=München,C=DE
2	CN=Fixture Issuing CA 1+OU=Issuing,O=Fixture Trust,C=US

query TTTTT
SELECT s.issuer, s.serial, s.not_before, s.not_after, s.san_dns
FROM (SELECT unnest(server_certificates) AS s FROM read_tls('test/data/tls/certificates.pcap'));
----
CN=Fixture Issuing CA 1+OU=Issuing,O=Fixture Trust,C=US	008f3a1042	2025-03-01 12:00:00	2026-03-01 12:00:00	[www.example.test, example.test, *.cdn.example.test]
CN=Fixture Root CA,O=Fixture Trust,C=US	01	2020-01-01 00:00:00	2050-12-31 23:59:59	[]

query TT
SELECT server_certificates[1].san_ip, warnings FROM read_tls('test/data/tls/certificates.pcap');
----
[192.0.2.44, '2001:db8::44']	[]

# A certificate that does not parse is a NULL element, so the chain keeps its
# length and order, and the row says so.
query IITT
SELECT len(server_certificates), server_certificates[1].serial IS NOT NULL, server_certificates[2] IS NULL, warnings
FROM read_tls('test/data/tls/certificate_malformed.pcap');
----
2	1	1	[server_certificate_malformed]

# TLS 1.3 encrypts the Certificate message, and a hello-only capture has none.
query II
SELECT count(*), count(server_certificates) FROM read_tls(['test/data/tls/browser_tls13.pcap', 'test/data/tls/session.pcap']);
----
2	0

# JA4X for each certificate in the chain, and its raw form. Expected values are
# from the FoxIO rust reference (FoxIO-LLC/ja4 at 16b96d9, rust/ja4x) run on the
# DER tshark extracted. The intermediate has no extensions: the rust reference,
# like JA4, writes an empty part as zeros. FoxIO License 1.1; see NOTICE.
query ITT
SELECT i, s.ja4x, s.ja4x_r FROM (SELECT unnest(server_certificates) AS s, generate_subscripts(server_certificates, 1) AS i
FROM read_tls('test/data/tls/certificates.pcap')) ORDER BY i;
----
1	7d5dbb3783b4_3170afc38336_6ea8df877ef2	550406,55040a,55040b,550403_550406,550407,55040a,55040a,2a864886f70d010901,2b0601040183b20301,550403_551d11
2	a373a9f83c6b_7d5dbb3783b4_000000000000	550406,55040a,550403_550406,55040a,55040b,550403_

# Each hash is the first 12 hex digits of SHA-256 over its raw part.
query I
WITH c AS (SELECT unnest(server_certificates) AS s FROM read_tls('test/data/tls/*.pcap')),
parts AS (SELECT s.ja4x AS ja4x, string_split(s.ja4x_r, '_') AS r FROM c WHERE s IS NOT NULL)
SELECT count(*) FROM parts
WHERE ja4x IS DISTINCT FROM array_to_string(list_transform(r, lambda p: CASE WHEN p = '' THEN '000000000000' ELSE left(sha256(p), 12) END), '_');
----
0

# TLS behind a tunnel. Prefix lengths are tshark 4.2.2's relative tcp.seq of
# the segment that starts each hello, less one. Port 51007 is an HTTP proxy
# login: CONNECT, 407 with a page, CONNECT with credentials, 200. A SOCKS4 reply cannot tell 4
# from 4a, so the protocol comes from the client's request.
query IIIIIII
SELECT client_port, tls_sni, reassembly_status, tunnel.protocol, tunnel.destination,
       tunnel.client_prefix_bytes, tunnel.server_prefix_bytes
FROM read_tls('test/data/tls/tunnels.pcap') ORDER BY client_port;
----
51001	login.live.com	complete	socks5	login.live.com:443	34	14
51002	c2.example	complete	socks4a	c2.example:443	23	8
51003	proxy.example	complete	http_connect	proxy.example:8443	65	61
51004	neris.example	complete	socks5	NULL	14	12
51006	one-sided.example	one-sided	socks5	192.0.2.9:443	13	NULL
51007	login.example	complete	http_connect	login.example:443	167	3147

# The Neris shape: a stray byte before the client's SOCKS5 greeting is not
# SOCKS, so no destination is claimed and the row says why.
query II
SELECT client_port, warnings FROM read_tls('test/data/tls/tunnels.pcap') ORDER BY client_port;
----
51001	[]
51002	[]
51003	[]
51004	[client_tunnel_unrecognized]
51006	[server_hello_missing]
51007	[]

# TLS that begins its stream has no tunnel.
query I
SELECT count(*) FROM read_tls('test/data/tls/*.pcap') WHERE tunnel IS NOT NULL AND filename NOT LIKE '%tunnels.pcap';
----
0

# A one-sided tunnel gives no length for the side that was not captured.
query IIII
SELECT tunnel.protocol, tunnel.destination, tunnel.client_prefix_bytes, tunnel.server_prefix_bytes IS NULL
FROM read_tls('test/data/tls/tunnels.pcap') WHERE client_port = 51006;
----
socks5	192.0.2.9:443	13	true

# Hashes, algorithms, keys and usage, each from OpenSSL 3.0.13's -fingerprint
# and -text for the DER tshark extracted. Usage names are RFC 5280's; OpenSSL
# prints "Digital Signature" for digitalSignature, and a purpose without an
# RFC 5280 name, here Microsoft Server Gated Crypto, is its OID.
query IIIIIIIIIII
SELECT i, s.sha1, s.sha256, s.signature_algorithm, s.public_key_algorithm, s.public_key_bits, s.public_key_curve,
       s.is_ca, s.path_length, s.key_usage, s.extended_key_usage
FROM (SELECT unnest(server_certificates) AS s, generate_subscripts(server_certificates, 1) AS i
      FROM read_tls('test/data/tls/certificate_details.pcap') WHERE client_port = 51000) ORDER BY i;
----
1	faf848a99542af602d350e6b1632459b678dffe0	b2510a9be41c4be68cde00ca1d1b5b3110198b5f80e4eac63a4eabe3cd0d5ac1	sha256WithRSAEncryption	rsaEncryption	2048	NULL	false	NULL	[digitalSignature, keyEncipherment]	[serverAuth, clientAuth, 1.3.6.1.4.1.311.10.3.3]
2	35c4db6f8531c726c2301f7db44ce7069d4d39d6	67140e4b6b6656ddd3a1b4f94086b8edae6e52c572faae10a22cb95a052369e9	ecdsa-with-SHA256	id-ecPublicKey	256	prime256v1	true	0	[keyCertSign, cRLSign]	NULL

# The client's certificate, sent after its hello. An Ed25519 key has no size
# OpenSSL prints. The second connection's client was asked and sent none.
query IIIIII
SELECT client_port, len(client_certificates), client_certificates[1].sha1, client_certificates[1].public_key_algorithm,
       client_certificates[1].public_key_bits, client_certificates[1].extended_key_usage
FROM read_tls('test/data/tls/certificate_details.pcap') ORDER BY client_port;
----
51000	1	c780daff8e7c323e7a516f84ad1ad409cab9f0cd	ED25519	NULL	[clientAuth]
51001	0	NULL	NULL	NULL	NULL

# No basicConstraints, keyUsage or extendedKeyUsage extension is NULL, not false or [].
query IIIII
SELECT s.sha1, s.is_ca, s.path_length, s.key_usage, s.extended_key_usage
FROM (SELECT unnest(server_certificates) AS s FROM read_tls('test/data/tls/certificates.pcap')) ORDER BY s.sha1;
----
0195d962e51c74d40289f5ac42493cd2f207efdf	NULL	NULL	NULL	NULL
4b37561d7c35b011a8c7ad05a07e6385f02530db	NULL	NULL	NULL	NULL

# A client that sent no Certificate message has client_certificates NULL.
query I
SELECT count(*) FROM read_tls('test/data/tls/*.pcap') WHERE client_certificates IS NOT NULL AND filename NOT LIKE '%certificate_details.pcap';
----
0
