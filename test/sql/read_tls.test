----
NULL	NULL	e8c07683aecf9b16e8e33f10a5161e4e	771,4865,

# A malformed or over-limit input list makes the fingerprint NULL. tshark
# hashes the valid prefix here instead (cf1e50cd... and 7a26e476...); a
# fingerprint over part of a list matches nothing and looks as if it should.
query IIII
SELECT ja3, ja3_full, warnings, reassembly_status FROM read_tls('test/data/tls/malformed_groups.pcap');
----
NULL	NULL	[server_hello_missing, client_list_malformed]	one-sided

query II
SELECT ja3, reassembly_status FROM read_tls('test/data/tls/list_limit.pcap');
----
NULL	limit

# The hash is the MD5 of the full string.
query I
SELECT count(*) FROM read_tls('test/data/tls/*.pcap')
WHERE ja3 IS DISTINCT FROM md5(ja3_full) OR ja3s IS DISTINCT FROM md5(ja3s_full);
----
0

# JA4 and JA4S, per FoxIO-LLC/ja4 at 16b96d9. JA4 values are tshark 4.2.2's
# tls.handshake.ja4 and ja4_r, except that an empty list is written as
# 000000000000, as JA4.md and both FoxIO implementations say, where tshark
# 4.2.2 hashes the empty string (e3b0c44298fc). tshark has no JA4S; JA4S values
# are from the FoxIO python reference, python/ja4.py.
# JA4S is licensed under the FoxIO License 1.1; see NOTICE.
query IIII
SELECT ja4, ja4_r, ja4s, ja4s_r FROM read_tls('test/data/tls/browser_tls13.pcap');
----
t13d1514h2_8daaf6152771_bc9a4605e104	t13d1514h2_002f,0035,009c,009d,1301,1302,1303,c013,c014,c02b,c02c,c02f,c030,cca8,cca9_0005,000a,000b,000d,0012,0017,001b,0023,002b,002d,0033,ff01_0403,0804,0401,0503,0805,0501,0806,0601	t130200_1301_a56c5b993250	t130200_1301_002b,0033

query IIII
SELECT ja4, ja4_r, ja4s, ja4s_r FROM read_tls('test/data/tls/tls12_alpn.pcap');
----
t12d0406h2_ec7724f63c6c_7081bc90e5b0	t12d0406h2_002f,009c,c02b,c02f_000a,000b,000d,0017_0401,0403	t1204h1_c02f_f8a64b40b891	t1204h1_c02f_ff01,000b,0010,0017

# JA4S counts and hashes GREASE in the ServerHello; JA4 drops it.
query IIII
SELECT ja4, ja4_r, ja4s, ja4s_r FROM read_tls('test/data/tls/ja3_legacy.pcap');
----
t10d020300_4f212281e1ff_33a13ba74d1c	t10d020300_0035,c013_000a,000b	t100300_c013_4ada57960b35	t100300_c013_3a3a,ff01,000b

# An empty list is 000000000000, not the hash of nothing.
query IIII
SELECT ja4, ja4_r, ja4s, ja4s_r FROM read_tls('test/data/tls/session.pcap');
----
t12d010100_0f2cb44170f4_000000000000	t12d010100_1301_	t120000_1301_000000000000	t120000_1301_

query II
SELECT ja4, ja4_r FROM read_tls('test/data/tls/no_extensions.pcap');
