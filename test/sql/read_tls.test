# name: test/sql/read_tls.test
# description: per-handshake TLS reporting over the shared TCP reassembly core
# group: [sql]

require packetquapture

# Both directions captured: the offered name and the selected parameters arrive
# on one row.
query IIIIIIIII
SELECT client_ip, server_ip, client_port, server_port, handshake_number,
       client_hello, server_hello, tls_sni, reassembly_status
FROM read_tls('test/data/tls/session.pcap');
----
192.0.2.1	198.51.100.2	51000	443	1	true	true	example.com	complete

query III
SELECT client_version, negotiated_version, cipher_suite
FROM read_tls('test/data/tls/session.pcap');
----
771	771	4865

# A ClientHello split across two TLS records and two TCP segments. The
# single-packet layer cannot see this name; reassembly is the point of read_tls.
query II
SELECT tls_sni, reassembly_status FROM read_tls('test/data/tls/split.pcap');
----
split.example.com	complete

query I
SELECT count(*) FILTER (WHERE tls_sni IS NOT NULL)
FROM read_packets('test/data/tls/split.pcap');
----
0

# Only the client direction was captured: the server columns stay NULL rather
# than being guessed, and the row is marked one-sided.
query IIIIII
SELECT client_hello, server_hello, tls_sni, negotiated_version, cipher_suite, reassembly_status
FROM read_tls('test/data/tls/client_only.pcap');
----
true	false	example.com	NULL	NULL	one-sided

query I
SELECT server_stream_id IS NULL FROM read_tls('test/data/tls/client_only.pcap');
----
true

# Only the server direction was captured. The key is still oriented client to
# server, so rows from either case line up in one report.
query IIIIII
SELECT client_ip, server_ip, client_port, client_hello, server_hello, reassembly_status
FROM read_tls('test/data/tls/server_only.pcap');
----
192.0.2.1	198.51.100.2	51000	false	true	one-sided

query II
SELECT client_stream_id IS NULL, tls_sni IS NULL
FROM read_tls('test/data/tls/server_only.pcap');
----
true	true

# Renegotiation in the clear produces a numbered row per handshake.
query III
SELECT handshake_number, tls_sni, reassembly_status
FROM read_tls('test/data/tls/renegotiated.pcap') ORDER BY handshake_number;
----
1	example.com	complete
2	second.example.com	complete

# Parsing stops at change_cipher_spec: records after it are encrypted, and the
# bytes here would otherwise read as a second ClientHello.
query II
SELECT count(*), max(tls_sni) FROM read_tls('test/data/tls/encrypted_after_ccs.pcap');
----
1	example.com

# TCP that is not TLS produces no rows at all.
query I
SELECT count(*) FROM read_tls('test/data/tls/plain_tcp.pcap');
----
0

# Neither does traffic with no TCP payload.
query I
SELECT count(*) FROM read_tls('test/data/dns/response.pcapng');
----
0

# With both directions and TLS 1.2, resumption is decidable: this client offered
# no session id, so it is a full handshake rather than a resumption.
query I
SELECT session_resumed FROM read_tls('test/data/tls/session.pcap');
----
false

# One direction alone cannot answer the question, so it is left NULL rather than
# reported as a full handshake.
query I
SELECT session_resumed FROM read_tls('test/data/tls/client_only.pcap');
----
NULL

# Reading several captures at once keeps each handshake with its own file.
query II
SELECT regexp_extract(filename, '[^/]+$'), tls_sni
FROM read_tls(['test/data/tls/session.pcap', 'test/data/tls/split.pcap'])
ORDER BY tls_sni;
----
session.pcap	example.com
split.pcap	split.example.com

# Provenance points at the packets that carried the handshake.
query II
SELECT first_packet_number <= last_packet_number, first_timestamp IS NOT NULL
FROM read_tls('test/data/tls/session.pcap');
----
true	true

# Results do not depend on the thread count.
statement ok
SET threads=4;

query II
SELECT count(*), count(*) FILTER (WHERE reassembly_status = 'complete')
FROM read_tls(['test/data/tls/session.pcap', 'test/data/tls/split.pcap',
               'test/data/tls/renegotiated.pcap', 'test/data/tls/client_only.pcap',
               'test/data/tls/server_only.pcap', 'test/data/tls/plain_tcp.pcap']);
----
6	4

statement ok
SET threads=1;

query II
SELECT count(*), count(*) FILTER (WHERE reassembly_status = 'complete')
FROM read_tls(['test/data/tls/session.pcap', 'test/data/tls/split.pcap',
               'test/data/tls/renegotiated.pcap', 'test/data/tls/client_only.pcap',
               'test/data/tls/server_only.pcap', 'test/data/tls/plain_tcp.pcap']);
----
6	4

# A server name that is not valid UTF-8 is escaped, not fatal: printable ASCII
# passes through and every other byte, and backslash, becomes decimal \DDD.
query II
SELECT tls_sni, reassembly_status FROM read_tls('test/data/tls/hostile_sni.pcap');
----
a\255\254\032b\092c.example	complete

# Parsed hello lists. Expected values are tshark 4.2.2's, converted to decimal;
# scripts/compare_tls_tshark.py repeats the comparison over every fixture.
# Lists are in wire order and include GREASE; the _no_grease twins drop the
# RFC 8701 values.
query IIIII
SELECT client_cipher_suites, client_extensions, client_supported_groups,
       client_signature_algorithms, client_supported_versions
FROM read_tls('test/data/tls/browser_tls13.pcap');
----
[2570, 4865, 4866, 4867, 49195, 49199, 49196, 49200, 52393, 52392, 49171, 49172, 156, 157, 47, 53]	[6682, 0, 23, 65281, 10, 11, 35, 16, 5, 13, 18, 51, 45, 43, 27, 19018]	[10794, 29, 23, 24]	[1027, 2052, 1025, 1283, 2053, 1281, 2054, 1537]	[14906, 772, 771]

query IIIII
SELECT client_cipher_suites_no_grease, client_extensions_no_grease, client_supported_groups_no_grease,
       client_signature_algorithms_no_grease, client_supported_versions_no_grease
FROM read_tls('test/data/tls/browser_tls13.pcap');
----
[4865, 4866, 4867, 49195, 49199, 49196, 49200, 52393, 52392, 49171, 49172, 156, 157, 47, 53]	[0, 23, 65281, 10, 11, 35, 16, 5, 13, 18, 51, 45, 43, 27]	[29, 23, 24]	[1027, 2052, 1025, 1283, 2053, 1281, 2054, 1537]	[772, 771]

# TLS 1.3 encrypts ALPN, so the ServerHello carries none.
query IIIIIII
SELECT client_ec_point_formats, client_alpn, client_alpn_no_grease, server_extensions,
       server_alpn, negotiated_version, warnings
FROM read_tls('test/data/tls/browser_tls13.pcap');
----
[0]	[h2, http/1.1]	[h2, http/1.1]	[43, 51]	NULL	772	[]

query IIIIIIII
SELECT client_cipher_suites, client_extensions, client_supported_groups, client_signature_algorithms,
       client_supported_versions, client_ec_point_formats, server_extensions, server_alpn
FROM read_tls('test/data/tls/tls12_alpn.pcap');
----
[49199, 49195, 156, 47]	[0, 10, 11, 13, 16, 23]	[23, 29]	[1025, 1027]	NULL	[0, 1, 2]	[65281, 11, 16, 23]	http/1.1

# More than 99 cipher suites and no SNI: every suite is kept.
query IIII
SELECT len(client_cipher_suites), client_cipher_suites[1], client_cipher_suites[-1], tls_sni
FROM read_tls('test/data/tls/many_ciphers.pcap');
----
120	1	120	NULL

# A list the hello did not carry is NULL; one it carried empty is []. A parsed
# hello always has cipher suites and extension types.
query IIII
SELECT client_cipher_suites, client_extensions, client_supported_groups, client_alpn
FROM read_tls('test/data/tls/no_extensions.pcap');
----
[4865]	[]	NULL	NULL

# ALPN identifiers are peer-supplied bytes and are escaped like tls_sni. The
# GREASE identifier 0x0A0A is two newlines, dropped from the filtered twin.
query II
SELECT client_alpn, client_alpn_no_grease
FROM read_tls('test/data/tls/alpn_edges.pcap') ORDER BY client_port;
----
[\010\010, h2]	[h2]
[x]	[x]
[\171\001, h2]	[\171\001, h2]

# supported_groups with an odd length. tshark reads a partial list; read_tls
# reports it NULL with a warning, and the rest of the hello still parses.
query IIIII
SELECT tls_sni, client_supported_groups, client_extensions, reassembly_status, warnings
FROM read_tls('test/data/tls/malformed_groups.pcap');
----
odd.example.com	NULL	[0, 10]	one-sided	[server_hello_missing, client_list_malformed]

# More cipher suites than max_list_entries: the hello is reported at the limit
# rather than with a list silently cut short.
query III
SELECT client_cipher_suites, reassembly_status, reassembly_error
FROM read_tls('test/data/tls/list_limit.pcap');
----
NULL	limit	TLS hello list exceeds the per-list limit

# One side captured: that side's lists are reported, the other side's are
# NULL, and warnings names the missing side.
query IIII
SELECT client_cipher_suites, server_extensions, reassembly_status, warnings
FROM read_tls('test/data/tls/client_only.pcap');
----
[4865]	NULL	one-sided	[server_hello_missing]

query IIII
SELECT client_cipher_suites, server_extensions, reassembly_status, warnings
FROM read_tls('test/data/tls/server_only.pcap');
----
NULL	[]	one-sided	[client_hello_missing]

# Without a SYN the status is unanchored, which outranks one-sided: warnings is
# where the missing side is still visible.
query II
SELECT reassembly_status, warnings FROM read_tls('test/data/tls/no_sni.pcap');
----
unanchored	[server_hello_missing]

query I
SELECT warnings FROM read_tls('test/data/tls/session.pcap');
----
[]

# JA3 and JA3S. Expected values are tshark 4.2.2's tls.handshake.ja3, ja3_full,
# ja3s and ja3s_full; the format is salesforce/ja3 at 502cc63. GREASE is
# dropped and the version is legacy_version on both sides, even in TLS 1.3.
query IIII
SELECT ja3, ja3_full, ja3s, ja3s_full FROM read_tls('test/data/tls/browser_tls13.pcap');
----
7f805430de1e7d98b1de033adb58cf46	771,4865-4866-4867-49195-49199-49196-49200-52393-52392-49171-49172-156-157-47-53,0-23-65281-10-11-35-16-5-13-18-51-45-43-27,29-23-24,0	f4febc55ea12b31ae17cfb7e614afda8	771,4865,43-51

query IIII
SELECT ja3, ja3_full, ja3s, ja3s_full FROM read_tls('test/data/tls/tls12_alpn.pcap');
----
0d38ad16654d0b73f027fef0df13e5b6	771,49199-49195-156-47,0-10-11-13-16-23,23-29,0-1-2	27eabd2e03c903c0e38682b67d24b578	771,49199,65281-11-16-23

# GREASE in the ServerHello is dropped too; a TLS 1.0 legacy_version is 769.
query IIII
SELECT ja3, ja3_full, ja3s, ja3s_full FROM read_tls('test/data/tls/ja3_legacy.pcap');
----
a6d8f68f8fe89f743b91590739d66a16	769,49171-53,0-10-11,23,0	184d532a16876b78846ae6a03f654890	769,49171,65281-11

# Lists the hello did not carry are empty fields.
query II
SELECT ja3, ja3_full FROM read_tls('test/data/tls/no_extensions.pcap');
