query III rowsort
SELECT link_type, src_port, payload_offset
FROM read_packets(['test/data/protocols/raw.pcap', 'test/data/protocols/ipv4.pcap',
                   'test/data/protocols/ipv6.pcap', 'test/data/protocols/sll.pcap',
                   'test/data/protocols/sll2.pcap', 'test/data/protocols/unknown.pcap']);
----
101	5353	28
113	5353	44
228	5353	28
229	5353	48
276	5353	68
999	NULL	NULL

query III
SELECT count(*), count(src_mac), count(vlan_ids)
FROM read_packets('test/data/protocols/raw.pcap');
----
1	0	0

query TIII
SELECT capture_format, src_port, payload_offset, payload_length
FROM read_packets('test/data/protocols/ethernet.pcapng');
----
pcapng	12345	54	5

# Preserve raw schema, bytes, and metadata on every malformed/unsupported row.
query I
SELECT count(*) FROM (
  (SELECT filename, packet_number, timestamp, captured_length, original_length, link_type,
          interface_id, packet_offset, capture_format, packet_data, section_number
   FROM read_packets('test/data/protocols/*'))
  EXCEPT ALL (SELECT * FROM read_pcap('test/data/protocols/*'))
);
----
0

# Filters retain SQL null semantics; validity must reset between output chunks.
query IIII
SELECT count(*), count(src_port), count(tcp_flags), sum(payload_length)
FROM read_packets('test/data/protocols/chunks.pcap');
----
4500	3000	1500	12000

query I
SELECT count(*) FROM read_packets('test/data/protocols/chunks.pcap') WHERE dst_port = 443;
----
1500

# Link-only and network-only projections retain valid lower layers.
query II
SELECT count(src_mac), count(ip_version) FROM read_packets('test/data/protocols/ethernet.pcap');
----
31	22

query I
SELECT count(src_mac) FROM read_packets('test/data/protocols/ethernet.pcap');
----
31

# Checked seeks must not hide physically truncated packet bytes or block trailers.

statement error
SELECT count(*) FROM read_packets('test/data/malformed/payload.pcap');
----
Unexpected end

statement error
SELECT count(src_mac) FROM read_packets('test/data/malformed/payload.pcap');
----
Unexpected end

