# name: test/sql/read_packets.test
# description: bounded protocol decoding with lossless raw packet rows
# group: [sql]

require packetquapture

query I
SELECT count(*) FROM read_packets('test/data/protocols/ethernet.pcap');
----
34

query ITTTTIIIIIIIIII
SELECT packet_number, src_mac, dst_mac, src_ip, dst_ip, ether_type, ip_version,
       ip_protocol, ip_ttl, src_port, dst_port, tcp_flags, tcp_seq, tcp_ack, payload_length
FROM read_packets('test/data/protocols/ethernet.pcap') WHERE packet_number = 1;
----
1	00:11:22:33:44:55	aa:bb:cc:dd:ee:ff	192.0.2.1	198.51.100.2	2048	4	6	64	12345	443	18	16909060	84281096	5

query ITIIII
SELECT packet_number, vlan_ids::VARCHAR, ether_type, udp_length, payload_offset, payload_length
FROM read_packets('test/data/protocols/ethernet.pcap') WHERE packet_number = 2;
----
2	[100, 200]	2048	11	50	3

query TTTII
SELECT src_ip, dst_ip, vlan_ids::VARCHAR, payload_offset, ip_id
FROM read_packets('test/data/protocols/ethernet.pcap') WHERE packet_number = 3;
----
2001:0db8:0000:0000:0000:0000:0000:0001	2001:0db8:0000:0000:0000:0000:0000:0002	[]	62	NULL

