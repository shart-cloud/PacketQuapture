query I
SELECT count(*) FROM ((SELECT p.* FROM ${reader}(['test/data/partitioned/dt=2026-09-18/host=001/capture.pcap','test/data/partitioned/dt=2026-09-17/host=002/capture.pcap','test/data/partitioned/dt=2026-09-18/host=001/capture.pcap'], hive_partitioning=true, hive_types={'dt':DATE}) p JOIN (VALUES ('001'), ('missing')) selected(host) ON p.host=selected.host EXCEPT ALL SELECT p.* FROM partitioned p JOIN (VALUES ('001'), ('missing')) selected(host) ON p.host=selected.host) UNION ALL (SELECT p.* FROM partitioned p JOIN (VALUES ('001'), ('missing')) selected(host) ON p.host=selected.host EXCEPT ALL SELECT p.* FROM ${reader}(['test/data/partitioned/dt=2026-09-18/host=001/capture.pcap','test/data/partitioned/dt=2026-09-17/host=002/capture.pcap','test/data/partitioned/dt=2026-09-18/host=001/capture.pcap'], hive_partitioning=true, hive_types={'dt':DATE}) p JOIN (VALUES ('001'), ('missing')) selected(host) ON p.host=selected.host));
----
0

statement ok
CREATE OR REPLACE TEMP TABLE globbed AS SELECT * FROM ${reader}('test/data/partitioned/*/*/*.pcap', hive_partitioning=true);

query I
SELECT count(*) FROM ((SELECT * FROM ${reader}('test/data/partitioned/*/*/*.pcap', hive_partitioning=true) WHERE host='001' EXCEPT ALL SELECT * FROM globbed WHERE host='001') UNION ALL (SELECT * FROM globbed WHERE host='001' EXCEPT ALL SELECT * FROM ${reader}('test/data/partitioned/*/*/*.pcap', hive_partitioning=true) WHERE host='001'));
----
0

# Reordered projections and an unprojected partition filter.
query TTI rowsort
SELECT host, dt::VARCHAR, count(*) > 0 FROM ${reader}(['test/data/partitioned/dt=2026-09-18/host=001/capture.pcap','test/data/partitioned/dt=2026-09-17/host=002/capture.pcap','test/data/partitioned/dt=2026-09-18/host=001/capture.pcap'], hive_partitioning=true, hive_types={'dt':DATE}) WHERE host='001' GROUP BY ALL;
----
001	2026-09-18	true

query I
SELECT count(*) FROM ${reader}(['test/data/partitioned/dt=2026-09-18/host=001/capture.pcap','test/data/partitioned/dt=2026-09-17/host=002/capture.pcap','test/data/partitioned/dt=2026-09-18/host=001/capture.pcap'], hive_partitioning=true, hive_types={'dt':DATE}) WHERE host='001' AND dt IS NULL;
----
0

statement ok
PREPARE selected AS WITH actual AS (SELECT * FROM ${reader}(['test/data/partitioned/dt=2026-09-18/host=001/capture.pcap','test/data/partitioned/dt=2026-09-17/host=002/capture.pcap','test/data/partitioned/dt=2026-09-18/host=001/capture.pcap'], hive_partitioning=true, hive_types={'dt':DATE}) WHERE host=$1), expected AS (SELECT * FROM partitioned WHERE host=$1) SELECT count(*) FROM ((SELECT * FROM actual EXCEPT ALL SELECT * FROM expected) UNION ALL (SELECT * FROM expected EXCEPT ALL SELECT * FROM actual));

query I
EXECUTE selected('001');
----
0

query I
EXECUTE selected('002');
----
0

query I
EXECUTE selected('missing');
----
0

query I
EXECUTE selected('001');
----
0

statement ok
DEALLOCATE selected;

# Excluded malformed captures must not be parsed.
query I
SELECT count(*) > 0 FROM ${reader}(['test/data/partitioned/dt=2026-09-18/host=001/capture.pcap', 'test/data/not-a-capture.bin', 'test/data/partitioned/dt=2026-09-18/host=001/capture.pcap']) WHERE filename='test/data/partitioned/dt=2026-09-18/host=001/capture.pcap';
----
true

query I
SELECT count(*) FROM ${reader}(['test/data/not-a-capture.bin']) WHERE filename='missing';
----
0

statement error
SELECT count(*) FROM ${reader}(['test/data/not-a-capture.bin']);
----

# A volatile predicate must never become evidence for excluding an input.
statement error
SELECT count(*) FROM ${reader}(['test/data/not-a-capture.bin']) WHERE random()<0;
----

statement error
SELECT * FROM ${reader}('test/data/partitioned/dt=2026-09-18/host=001/capture.pcap', hive_types={'dt':DATE});
