# name: test/sql/file_pruning.test
# description: file pruning preserves complete rows, occurrence identity and partition constants
# group: [sql]

require packetquapture

foreach reader read_pcap read_packets read_dns read_tcp_streams read_dns_messages

statement ok
SET threads=1;

statement ok
CREATE OR REPLACE TEMP TABLE plain AS SELECT * FROM ${reader}(['test/data/partitioned/dt=2026-09-18/host=001/capture.pcap','test/data/partitioned/dt=2026-09-17/host=002/capture.pcap','test/data/partitioned/dt=2026-09-18/host=001/capture.pcap']);

statement ok
CREATE OR REPLACE TEMP TABLE partitioned AS SELECT * FROM ${reader}(['test/data/partitioned/dt=2026-09-18/host=001/capture.pcap','test/data/partitioned/dt=2026-09-17/host=002/capture.pcap','test/data/partitioned/dt=2026-09-18/host=001/capture.pcap'], hive_partitioning=true, hive_types={'dt':DATE});

foreach workers 1 2 4 8

statement ok
SET threads=${workers};

query I
SELECT count(*) FROM ((SELECT * FROM ${reader}(['test/data/partitioned/dt=2026-09-18/host=001/capture.pcap','test/data/partitioned/dt=2026-09-17/host=002/capture.pcap','test/data/partitioned/dt=2026-09-18/host=001/capture.pcap']) WHERE filename='test/data/partitioned/dt=2026-09-18/host=001/capture.pcap' EXCEPT ALL SELECT * FROM plain WHERE filename='test/data/partitioned/dt=2026-09-18/host=001/capture.pcap') UNION ALL (SELECT * FROM plain WHERE filename='test/data/partitioned/dt=2026-09-18/host=001/capture.pcap' EXCEPT ALL SELECT * FROM ${reader}(['test/data/partitioned/dt=2026-09-18/host=001/capture.pcap','test/data/partitioned/dt=2026-09-17/host=002/capture.pcap','test/data/partitioned/dt=2026-09-18/host=001/capture.pcap']) WHERE filename='test/data/partitioned/dt=2026-09-18/host=001/capture.pcap'));
----
0

