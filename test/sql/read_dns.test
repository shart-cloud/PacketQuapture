# name: test/sql/read_dns.test
# description: DNS queries, responses, compression, malformed messages, and TCP boundaries
# group: [sql]

require packetquapture

query II
SELECT count(*), count(*) FILTER (WHERE dns_valid) FROM read_dns('test/data/dns/messages.pcap');
----
24	12

query IITII
SELECT packet_number, dns_response::INTEGER, dns_question_name, dns_question_type, dns_rcode
FROM read_dns('test/data/dns/messages.pcap') WHERE dns_valid;
----
1	0	example.com	1	0
2	1	example.com	1	0
3	1	example.com	28	0
4	1	example.com	1	0
5	1	example.com	1	3
6	1	example.com	1	0
7	0	NULL	NULL	0
8	0	example.com	1	0
9	1	example.com	1	0
17	0	a\000b	1	0
20	0	example.com	1	0
23	0	example.com	1	0

query ITTII
SELECT packet_number, answer.name, answer.value, answer.type, answer.ttl
FROM (SELECT packet_number, unnest(dns_answers) AS answer FROM read_dns('test/data/dns/messages.pcap'));
----
2	example.com	192.0.2.5	1	300
3	example.com	2001:0db8:0000:0000:0000:0000:0000:0005	28	300
4	example.com	www.example.com	5	300
4	www.example.com	192.0.2.9	1	300
6	example.com	NULL	65000	300

query TTIT
SELECT dns_authorities[1].value, dns_additionals[1].value, dns_answers[1].type, hex(dns_answers[1].data)
FROM read_dns('test/data/dns/messages.pcap') WHERE packet_number = 6;
----
ns.example.com	192.0.2.53	65000	6F7061717565

query III
SELECT len(dns_questions), dns_questions[2].type, dns_truncated::INTEGER
FROM read_dns('test/data/dns/messages.pcap') WHERE packet_number IN (8, 9);
----
2	28	0
1	NULL	1

query III
SELECT count(*), count(dns_id), count(dns_error)
FROM read_dns('test/data/dns/messages.pcap') WHERE NOT dns_valid;
----
12	0	12

query IIII
SELECT count(*), count(dns_id), count(dns_question_name), sum(len(dns_answers))
FROM read_dns('test/data/dns/chunks.pcap');
----
4500	3000	3000	1500

query TI
SELECT capture_format, dns_answers[1].type FROM read_dns('test/data/dns/response.pcapng');
----
pcapng	1

query I
SELECT count(*) FROM read_dns(['test/data/dns/messages.pcap', 'test/data/dns/response.pcapng'])
WHERE dns_response AND dns_question_name = 'example.com';
----
7