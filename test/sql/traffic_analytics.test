internal	2001:0db8:0000:0000:0000:0000:0000:0001	2001:0db8:0000:0000:0000:0000:0000:0002

query TTT
SELECT finalized_by, duration IS NULL, quality_flags
FROM packetquapture_connection_facts('test/data/flows/scopes.pcapng', ['192.0.2.0/24'])
WHERE duration IS NULL;
----
section_boundary	true	[missing_timestamps, partial_session, ambiguous_orientation, capture_boundary]

query II
SELECT count(*) FILTER (WHERE list_contains(quality_flags, 'late_packets')),
       count(*) FILTER (WHERE finalized_by = 'idle_timeout')
FROM packetquapture_connection_facts(
    'test/data/flows/udp.pcap', ['192.0.2.0/24'], udp_idle_timeout := INTERVAL '10 microseconds');
----
2	2

query I
SELECT count(*)
FROM packetquapture_connection_facts('test/data/flows/tcp.pcap', ['192.0.2.0/24'])
WHERE finalized_by = 'reset' AND partial_session;
----
1

query IIII
SELECT sum(a_packets+b_packets), sum(a_captured_bytes+b_captured_bytes),
       sum(a_reported_bytes+b_reported_bytes), sum(a_payload_bytes+b_payload_bytes)
FROM packetquapture_connection_facts('test/data/protocols/ethernet.pcap', ['192.0.2.0/24']);
----
10	637	637	22

query TTTT
SELECT sum(local_packets) = sum(b_packets), sum(remote_packets) = sum(a_packets),
       sum(local_captured_bytes + remote_captured_bytes) = sum(a_captured_bytes + b_captured_bytes),
       sum(local_payload_bytes + remote_payload_bytes) = sum(a_payload_bytes + b_payload_bytes)
FROM packetquapture_connection_facts('test/data/flows/tcp.pcap', ['198.51.100.0/24']);
----
true	true	true	true

