query IIIIIRRRRRTTII
SELECT connection_count, timed_connection_count, epoch_ms(observation_span),
       median_interval_ms::BIGINT, interval_mad_ms::BIGINT,
       timing_score, size_score, support_score, span_score, score,
       quality_flags, reasons, array_length(evidence), evidence_truncated::INTEGER
FROM analyze_beacons('test/data/flows/analytics.pcap', ['192.0.2.0/24'], evidence_rows := 3);
----
8	8	2100000	300000	0	100.000000	100.000000	66.666667	100.000000	95.000000	[partial_session, ambiguous_orientation, capture_boundary, evidence_truncated]	[connection starts have low interval dispersion, connection payload sizes have low dispersion, observations span the configured minimum]	3	1

# Repeated source occurrences remain repeated, but equal timestamps do not make zero intervals.
query III
SELECT connection_count, timed_connection_count, median_interval_ms::BIGINT
FROM analyze_beacons(['test/data/flows/analytics.pcap', 'test/data/flows/analytics.pcap'],
                     ['192.0.2.0/24']);
----
16	16	300000

query TT
SELECT timing_score IS NULL, list_contains(quality_flags, 'missing_timestamps')
FROM analyze_beacons('test/data/flows/scopes.pcapng', ['192.0.2.0/24'],
                     min_connections := 2, min_span := INTERVAL '0 seconds');
----
true	true

# Independently calculated timing and size distributions.
query IIIIIIII
SELECT remote_port, median_interval_ms::BIGINT, interval_mad_ms::BIGINT,
       median_payload_bytes::BIGINT, payload_mad_bytes::BIGINT,
       round(timing_score)::BIGINT, round(size_score)::BIGINT, round(score)::BIGINT
FROM analyze_beacons('test/data/flows/analytics_distributions.pcap', ['192.0.2.0/24'])
ORDER BY remote_port;
----
54	300000	60000	3	0	20	100	55
55	419000	222000	3	0	0	100	45
56	1000	0	3	0	100	100	95
57	300000	0	153	150	100	0	75

# Input ordering changes occurrence-local evidence IDs, but not analytical metrics.
query I
WITH forward AS (
    SELECT local_ip, remote_ip, remote_port, connection_count, timed_connection_count,
           observation_span, median_interval_ms, interval_mad_ms,
           median_payload_bytes, payload_mad_bytes, timing_score, size_score,
           support_score, span_score, score
    FROM analyze_beacons(
        ['test/data/flows/analytics.pcap', 'test/data/flows/analytics_distributions.pcap'],
        ['192.0.2.0/24'])
), reverse_order AS (
    SELECT local_ip, remote_ip, remote_port, connection_count, timed_connection_count,
           observation_span, median_interval_ms, interval_mad_ms,
           median_payload_bytes, payload_mad_bytes, timing_score, size_score,
           support_score, span_score, score
    FROM analyze_beacons(
        ['test/data/flows/analytics_distributions.pcap', 'test/data/flows/analytics.pcap'],
        ['192.0.2.0/24'])
)
SELECT count(*) FROM (
    (SELECT * FROM forward EXCEPT ALL SELECT * FROM reverse_order)
    UNION ALL
    (SELECT * FROM reverse_order EXCEPT ALL SELECT * FROM forward)
);
----
0

# An unrelated service does not change an existing group's metrics.
query I
WITH alone AS (
    SELECT * EXCLUDE (finding_id, rank, evidence, evidence_truncated, quality_flags)
    FROM analyze_beacons('test/data/flows/analytics.pcap', ['192.0.2.0/24'])
), combined AS (
    SELECT * EXCLUDE (finding_id, rank, evidence, evidence_truncated, quality_flags)
    FROM analyze_beacons(
        ['test/data/flows/analytics.pcap', 'test/data/flows/analytics_distributions.pcap'],
        ['192.0.2.0/24'])
    WHERE remote_port = 53
)
SELECT count(*) FROM (
    (SELECT * FROM alone EXCEPT ALL SELECT * FROM combined)
    UNION ALL
    (SELECT * FROM combined EXCEPT ALL SELECT * FROM alone)
);
----
0

statement ok
SET threads=1;

statement ok
CREATE TEMP TABLE expected_analytics AS
SELECT * FROM analyze_beacons(
    ['test/data/flows/analytics_distributions.pcap', 'test/data/flows/analytics.pcap'],
    ['192.0.2.0/24']);

statement ok
SET threads=8;

query I
SELECT count(*) FROM (
    (SELECT * FROM analyze_beacons(
        ['test/data/flows/analytics_distributions.pcap', 'test/data/flows/analytics.pcap'],
        ['192.0.2.0/24']) EXCEPT ALL SELECT * FROM expected_analytics)
    UNION ALL
    (SELECT * FROM expected_analytics EXCEPT ALL SELECT * FROM analyze_beacons(
        ['test/data/flows/analytics_distributions.pcap', 'test/data/flows/analytics.pcap'],
        ['192.0.2.0/24']))
);
----
0

statement ok
DROP TABLE expected_analytics;

