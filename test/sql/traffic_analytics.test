ORDER BY source_record_id;
----
inbound	198.51.100.2	192.0.2.1
inbound	198.51.100.2	192.0.2.1
inbound	198.51.100.2	192.0.2.1

query TII
SELECT direction, count(*), count(DISTINCT local_ip)
FROM packetquapture_connection_facts(
    'test/data/flows/tcp.pcap', ['192.0.2.0/24', '198.51.100.0/24'])
GROUP BY direction;
----
internal	3	1

query TII
SELECT direction, count(*), count(local_ip)
FROM packetquapture_connection_facts('test/data/flows/tcp.pcap', ['203.0.113.0/24'])
GROUP BY direction;
----
external	3	0

query TTTT
SELECT direction, initiator, local_ip, remote_ip
FROM packetquapture_connection_facts(
    'test/data/flows/simultaneous_open.pcap', ['192.0.2.0/24']);
