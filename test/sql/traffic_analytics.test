# name: test/sql/traffic_analytics.test
# description: Normalized connection facts, talkers, long connections and beacon scoring
# group: [sql]

require packetquapture

query TTTT
SELECT packetquapture_ip_in_cidrs('10.255.255.255', ['10.0.0.0/8']),
       packetquapture_ip_in_cidrs('11.0.0.0', ['10.0.0.0/8']),
       packetquapture_ip_in_cidrs('2001:db8:ffff::1', ['2001:db8::/32']),
       packetquapture_ip_in_cidrs('2001:db9::1', ['2001:db8::/32']);
----
true	false	true	false

query TTTTTTTTTT
SELECT packetquapture_ip_in_cidrs('203.0.113.9', ['0.0.0.0/0']),
       packetquapture_ip_in_cidrs('192.0.2.1', ['192.0.2.1/32']),
       packetquapture_ip_in_cidrs('192.0.2.2', ['192.0.2.1/32']),
       packetquapture_ip_in_cidrs('2001:db8:0:1:2:3:4:5', ['2001:db8:0:1:2:3:4:5/128']),
       packetquapture_ip_in_cidrs('2001:db8:0:1:2:3:4:6', ['2001:db8:0:1:2:3:4:5/128']),
       packetquapture_ip_in_cidrs('::1', ['::/0']),
       packetquapture_ip_in_cidrs('::ffff:192.0.2.1', ['::ffff:192.0.2.1/128']),
       packetquapture_ip_in_cidrs('2001::db8::1', ['::/0']) IS NULL,
       packetquapture_ip_in_cidrs(NULL, ['10.0.0.0/8']) IS NULL,
       packetquapture_ip_in_cidrs('10.0.0.1', NULL) IS NULL;
----
true	true	false	true	false	true	true	true	true	true

query TT
SELECT ip, packetquapture_ip_in_cidrs(ip, networks)
FROM (VALUES ('10.0.0.1', ['10.0.0.0/8']),
             ('192.0.2.1', ['10.0.0.0/8'])) addresses(ip, networks)
ORDER BY ip;
----
10.0.0.1	true
192.0.2.1	false

