query TTTTT
SELECT direction, local_ip, remote_ip, initiator, source_record_id
FROM packetquapture_connection_facts('test/data/flows/tcp.pcap', ['192.0.2.0/24'])
ORDER BY source_record_id;
----
outbound	192.0.2.1	198.51.100.2	a	1:1
outbound	192.0.2.1	198.51.100.2	a	1:7
outbound	192.0.2.1	198.51.100.2	a	1:9

query TTT
