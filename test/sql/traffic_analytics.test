unknown	unknown	192.0.2.1	198.51.100.2

query II
SELECT (SELECT count(*) FROM analyze_long_connections(
           'test/data/flows/simultaneous_open.pcap', ['192.0.2.0/24'],
           scope := 'outbound', min_duration := INTERVAL '0 seconds')),
       (SELECT count(*) FROM analyze_long_connections(
           'test/data/flows/simultaneous_open.pcap', ['192.0.2.0/24'],
           scope := 'local_remote', min_duration := INTERVAL '0 seconds'));
